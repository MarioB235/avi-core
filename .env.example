APP_NAME=AviCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=avicore
DB_USERNAME=postgres
DB_PASSWORD=

# Local: file. Producción/staging: database (invalidación de sesiones al resetear clave o desactivar usuario)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production/staging HTTPS: true (AppServiceProvider fuerza secure en production)
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Soporte — recuperación de acceso (login)
AVICORE_SUPPORT_WHATSAPP="+5491123456789"
AVICORE_SUPPORT_WHATSAPP_DISPLAY="+54 9 11 2345-6789"
AVICORE_SUPPORT_EMAIL="soporte@avicore.com"

# Proxies confiables (rate limiting / URL HTTPS). Local o Laravel Cloud: *. Producción propia: IPs del proxy.
TRUSTED_PROXIES=*

# Login demo — selector de perfil (sin credenciales en pantalla si true)
# Solo activo si existe empresa DEMO; forzado off en APP_ENV=production
AVICORE_DEMO_LOGIN=true
# Código de empresa demo requerida para activar el selector (default DEMO)
# AVICORE_DEMO_EMPRESA_CODIGO=DEMO
# Documentos demo por rol (defaults en config/avicore.php; contraseña seed: Avicore2026!)
# AVICORE_DEMO_DOCUMENTO_DUENO=000000000

# Versión de producto (semver) — visible en Perfil junto al build desplegado
AVICORE_VERSION=0.1.0-dev

# PWA — manifest, service worker y banner de instalación en móvil
AVICORE_PWA_ENABLED=true
AVICORE_PWA_INSTALL_PROMPT=true

# --- Laravel Cloud (staging) — configurar en el panel de Cloud, no en .env local ---
# APP_URL=https://tu-entorno.laravel.cloud
# APP_KEY=base64:...  (php artisan key:generate --show)
# APP_ENV=staging
# APP_DEBUG=false
# AVICORE_DEMO_DOCUMENTO=000000000
# Contraseña del usuario demo (seed): Avicore2026!
# DB_* — inyectadas automáticamente al adjuntar Laravel Serverless Postgres
