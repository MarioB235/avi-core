{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "build": "node scripts/write-build-meta.cjs && vite build",
        "dev": "vite",
        "check:agent-docs": "node scripts/check-agent-docs-sync.cjs && node scripts/check-skill-references.cjs",
        "check:docs-impact": "node scripts/check-docs-impact.cjs",
        "check:cloud-readiness": "node scripts/check-cloud-readiness.cjs",
        "check:security": "composer audit --locked && php artisan test --compact tests/Feature/Security tests/Unit/Services/EmpresaLogoPathGuardTest.php tests/Unit/Support",
        "check:operario": "php artisan test tests/Feature/Operario tests/Feature/Ui/OperarioCargarHubViewTest.php tests/Feature/Ui/OperarioBottomNavTest.php tests/Feature/Ui/OperarioUserMenuTest.php",
        "probe:operario": "php scripts/probe-login-operario.php",
        "portal:dev": "node scripts/serve-portal.cjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "workbox-window": "^7.4.1"
    },
    "dependencies": {
        "leaflet": "^1.9.4"
    }
}
